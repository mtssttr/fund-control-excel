let Racine = Text.Trim(Text.From(Excel.CurrentWorkbook(){[Name="p_DossierSource"]}[Content]{0}[Column1])), Source = Csv.Document(File.Contents(Racine & "/especes_internes.csv"), [Delimiter=";", Encoding=65001, QuoteStyle=QuoteStyle.Csv]), Entetes = Table.PromoteHeaders(Source, [PromoteAllScalars=true]), Types = Table.TransformColumnTypes(Entetes, {{"CashID", type text}, {"Date", type date}, {"MontantEUR", type number}, {"Libelle", type text}}, "en-US"), Identifiants = Table.TransformColumns(Types, {{"CashID", each if _ = null then null else Text.Upper(Text.Trim(_)), type text}}) in Identifiants
