let Racine = Text.Trim(Text.From(Excel.CurrentWorkbook(){[Name="p_DossierSource"]}[Content]{0}[Column1])), Source = Csv.Document(File.Contents(Racine & "/cours.csv"), [Delimiter=";", Encoding=65001, QuoteStyle=QuoteStyle.Csv]), Entetes = Table.PromoteHeaders(Source, [PromoteAllScalars=true]), Types = Table.TransformColumnTypes(Entetes, {{"PriceID", type text}, {"DateValorisation", type date}, {"ISIN", type text}, {"CoursEUR", type number}, {"DateCours", type date}, {"Devise", type text}}, "en-US"), Identifiants = Table.TransformColumns(Types, {{"PriceID", each if _ = null then null else Text.Upper(Text.Trim(_)), type text}, {"ISIN", each if _ = null then null else Text.Upper(Text.Trim(_)), type text}, {"Devise", each if _ = null then null else Text.Upper(Text.Trim(_)), type text}}) in Identifiants
