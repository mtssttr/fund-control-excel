let Racine = Text.Trim(Text.From(Excel.CurrentWorkbook(){[Name="p_DossierSource"]}[Content]{0}[Column1])), Source = Csv.Document(File.Contents(Racine & "/reglements_depositaire.csv"), [Delimiter=";", Encoding=65001, QuoteStyle=QuoteStyle.Csv]), Entetes = Table.PromoteHeaders(Source, [PromoteAllScalars=true]), Types = Table.TransformColumnTypes(Entetes, {{"RecordID", type text}, {"TradeID", type text}, {"DateNegociation", type date}, {"DatePrevue", type date}, {"DateEffective", type date}, {"ISIN", type text}, {"Sens", type text}, {"Quantite", type number}, {"PrixExecutionSimule", type number}, {"CourtageEUR", type number}, {"Devise", type text}}, "en-US"), Identifiants = Table.TransformColumns(Types, {{"RecordID", each if _ = null then null else Text.Upper(Text.Trim(_)), type text}, {"TradeID", each if _ = null then null else Text.Upper(Text.Trim(_)), type text}, {"ISIN", each if _ = null then null else Text.Upper(Text.Trim(_)), type text}, {"Sens", each if _ = null then null else Text.Upper(Text.Trim(_)), type text}, {"Devise", each if _ = null then null else Text.Upper(Text.Trim(_)), type text}}) in Identifiants
