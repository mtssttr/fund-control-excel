let Racine = Text.Trim(Text.From(Excel.CurrentWorkbook(){[Name="p_DossierSource"]}[Content]{0}[Column1])), Source = Csv.Document(File.Contents(Racine & "/positions_depositaire.csv"), [Delimiter=";", Encoding=65001, QuoteStyle=QuoteStyle.Csv]), Entetes = Table.PromoteHeaders(Source, [PromoteAllScalars=true]), Types = Table.TransformColumnTypes(Entetes, {{"Date", type date}, {"ISIN", type text}, {"QuantiteReglee", type number}}, "en-US"), Identifiants = Table.TransformColumns(Types, {{"ISIN", each if _ = null then null else Text.Upper(Text.Trim(_)), type text}}) in Identifiants
