let Racine = Text.Trim(Text.From(Excel.CurrentWorkbook(){[Name="p_DossierSource"]}[Content]{0}[Column1])), N = {try Table.RowCount(q_Transactions) otherwise -1,try Table.RowCount(q_Reglements) otherwise -1,try Table.RowCount(q_Cours) otherwise -1,try Table.RowCount(q_PositionsDepot) otherwise -1,try Table.RowCount(q_CashDepot) otherwise -1,try Table.RowCount(q_VLReference) otherwise -1,try Table.RowCount(q_CashInterne) otherwise -1,try Table.RowCount(q_FluxDepot) otherwise -1}, Dossier = if List.Contains(N,-1) then "ERREUR IMPORT: " & Racine else Racine, Resultat = #table({"DossierCharge","Transactions","Reglements","Cours","Positions","Especes","VL"}, {{Dossier,N{0},N{1},N{2},N{3},N{4},N{5}}}) in Resultat
