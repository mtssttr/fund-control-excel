let Racine = Text.Trim(Text.From(Excel.CurrentWorkbook(){[Name="p_DossierSource"]}[Content]{0}[Column1])), Source = Csv.Document(File.Contents(Racine & "/especes_depositaire.csv"), [Delimiter=";", Encoding=65001, QuoteStyle=QuoteStyle.Csv]), Entetes = Table.PromoteHeaders(Source, [PromoteAllScalars=true]), Types = Table.TransformColumnTypes(Entetes, {{"Date", type date}, {"SoldeEUR", type number}}, "en-US"), Identifiants = Table.TransformColumns(Types, {}) in Identifiants
